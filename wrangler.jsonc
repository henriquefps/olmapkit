{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olmapkit",
  "compatibility_date": "2026-09-25",
  // Static demo only: site/ is assembled by `npm run site` (demo/ + dist/ + legacy/ + _redirects)
  "assets": {
    "directory": "./site"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "olmapkit.hfps.dev", "custom_domain": true }
  ]
}
